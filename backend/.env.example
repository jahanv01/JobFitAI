# Copy this file to .env and fill in your values. .env is gitignored and must never be committed.

GEMINI_API_KEY=

# Token callers (e.g. the Chrome extension) must send back as the
# X-API-Key header on every request except /health. Generate any random
# string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
